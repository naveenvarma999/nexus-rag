# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8000
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nexus:development-only@db:5432/nexus
MAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
AWS_REGION=eu-west-2
# Local AI calls require credentials allowed to invoke your selected models.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
SES_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional in development, REQUIRED for production API. Use a separate random key.
# Example JSON shape only; never use these example values in production.
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=primary
SESSION_IDLE_SECONDS=1800
MAX_SESSIONS=5
APP_ROLE=api
